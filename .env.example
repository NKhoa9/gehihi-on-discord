# ── Required ──────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional ──────────────────────────────────────────────────────
ADMINS=your-user-id,another-user-id

# ── Web Config GUI (Optional) ─────────────────────────────────────
# Set PORT (or WEB_PORT) to your server allocated port
WEB_HOST = 127.0.0.1 # Local test; change to your server domain when implement 
PORT=12345
WEB_ENABLED=true
WEB_PASSWORD=change-me-to-a-strong-password

# WEB_SESSION_SECRET=random-long-secret

