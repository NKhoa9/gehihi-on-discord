# ── Required ──────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional ──────────────────────────────────────────────────────

# Model for normal casual chat (cheap, fast — does NOT need grounding support)
MODEL_FAST=gemini-3.1-flash-lite

# Model used only when a web search is needed (must support Google Search grounding)
MODEL_SEARCH=gemini-2.5-flash

# How many messages to keep in memory per channel (default: 30)
MAX_HISTORY=30
